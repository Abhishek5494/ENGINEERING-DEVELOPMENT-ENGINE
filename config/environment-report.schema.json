{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "environment-report.schema.json",
  "title": "Environment report (MASTER section 25)",
  "description": "Machine-readable environment report produced by src/pem/report.py. Regenerable, machine-specific, gitignored.",
  "type": "object",
  "required": [
    "generated_at",
    "platform",
    "tools",
    "missing_tools",
    "unknown_tools",
    "capabilities",
    "warnings",
    "limitations",
    "recommendations"
  ],
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "UTC ISO-8601 timestamp; the only non-deterministic field"
    },
    "platform": {
      "type": "object",
      "description": "detect_system() output: value/evidence field records plus storage"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "version", "executable_path", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["DETECTED", "NOT_FOUND", "UNKNOWN"] },
          "version": { "type": ["string", "null"] },
          "executable_path": { "type": "string", "minLength": 1 },
          "evidence": {
            "enum": [
              "OBSERVED",
              "MEASURED",
              "MANUFACTURER-SPECIFIED",
              "CALCULATED",
              "SIMULATED",
              "INFERRED",
              "ASSUMED",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "missing_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Exactly the tool ids whose state is NOT_FOUND"
    },
    "unknown_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Exactly the tool ids whose state is UNKNOWN"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "enum": ["READY", "LIMITED", "UNAVAILABLE", "UNKNOWN"] }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "recommendations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
