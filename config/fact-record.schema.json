{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIE field record",
  "description": "All facts known about one component field, with conflict status (MASTER section 11). Nothing is overwritten; the governing fact is a selection among the retained facts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["field", "status", "facts"],
  "properties": {
    "field": {"type": "string", "minLength": 1},
    "status": {"enum": ["UNKNOWN", "SINGLE", "AGREED", "CONFLICT"]},
    "facts": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
    "governing": {
      "anyOf": [{"$ref": "#/definitions/fact"}, {"type": "null"}]
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "retrieval_date", "kind"],
      "properties": {
        "source_url": {"type": "string", "minLength": 1},
        "retrieval_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "kind": {
          "enum": [
            "MANUFACTURER_DATASHEET",
            "MANUFACTURER_TECHNICAL_DOCUMENTATION",
            "MANUFACTURER_PRODUCT_PAGE",
            "AUTHORIZED_DISTRIBUTOR_DOCUMENTATION",
            "DISTRIBUTOR_PRODUCT_DOCUMENTATION",
            "MARKETPLACE_LISTING",
            "COMMUNITY_INFORMATION",
            "AI_INFERENCE"
          ]
        },
        "publisher": {"type": "string"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidence_label", "provenance"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean", "array", "object", "null"]
        },
        "evidence_label": {
          "enum": [
            "OBSERVED",
            "MEASURED",
            "MANUFACTURER-SPECIFIED",
            "CALCULATED",
            "SIMULATED",
            "INFERRED",
            "ASSUMED",
            "UNKNOWN"
          ]
        },
        "provenance": {"$ref": "#/definitions/provenance"}
      }
    }
  }
}